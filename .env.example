# Public base URL of the site, used for canonical, Open Graph, sitemap and feed URLs.
# REQUIRED in production (a build warning is printed when it is missing).
# No trailing slash. Example: https://truyen.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (leave empty to stream audio from local output/ instead)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional overrides
# Catalog directory (relative to web/ or absolute). Default: content
# Use content-demo for the fake demo catalog (see npm run dev:demo).
# CATALOG_DIR=
# Root folder containing <story_id>/audio/*.mp3. Default: ../output
# AUDIO_ROOT=

# Umami Analytics (privacy-friendly, self-hosted or cloud — https://umami.is)
# Set both vars to enable analytics. Leave empty to disable.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
